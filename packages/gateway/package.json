{
  "name": "@grokdesk/gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "pretest": "node ./scripts/ensure-native-abi.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "dependencies": {
    "@grokdesk/agent-runtime": "workspace:*",
    "@grokdesk/engine-grok": "workspace:*",
    "@grokdesk/license": "workspace:*",
    "@grokdesk/provider-echo": "workspace:*",
    "@grokdesk/provider-grok": "workspace:*",
    "@grokdesk/shared": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "cron-parser": "^4.9.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@grokdesk/engine-testkit": "workspace:*",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  }
}
